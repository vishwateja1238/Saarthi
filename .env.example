# Database used only by the pre-existing /api/health check. No applicant data is stored.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enables the Gemini assistance layer. If absent, the app runs on the deterministic rule engine alone.
# Never commit a real key.
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
